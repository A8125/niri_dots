layout {

    focus-ring {
        active-color   "#89d0ed"
        inactive-color "#0f1417"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#89d0ed"
        inactive-color "#0f1417"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#89d0ed"
        inactive-color "#004d62"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#89d0ed80"
    }
}

recent-windows {
    highlight {
        active-color "#89d0ed"
        urgent-color "#ffb4ab"
    }
}
